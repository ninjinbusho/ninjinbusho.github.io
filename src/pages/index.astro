<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ninjinbushoのwebサイト（仮）</title>
    <link rel="stylesheet" href="src\assets\styles.css" />
  </head>

  <body>
    <!-- Header Template -->
    <header class="site-header">
      <a class="brand" href="#">ninjinbushoのwebサイト（仮）</a>

      <nav class="site-nav" aria-label="主要ナビゲーション">
        <a href="">about</a>
        <a href="">空想地図「皆島」</a>
        <a href="">その他の作品</a>
      </nav>
    </header>

    <!-- Main Template -->
    <main class="site-main">
      <section class="hero">
        <div class="hero-content">
          <p class="eyebrow">Brand Website Template</p>
          <h1 class="hero-title">あああああああ</h1>
          <p>
            ninjinbushoのwebサイト（仮）へようこそ。
          </p>
          <a class="button" href="#contact">相談する</a>
        </div>
      </section>

      <section class="section" id="service">
        <h2>サービス</h2>
        <div class="card-grid">
          <article class="card">
            <h3>設計</h3>
            <p>情報を整理し、伝わりやすいページ構成を作ります。</p>
          </article>
          <article class="card">
            <h3>デザイン</h3>
            <p>信頼感と見やすさを両立したビジュアルに整えます。</p>
          </article>
          <article class="card">
            <h3>実装</h3>
            <p>HTMLとCSSだけで扱いやすい静的ページを作成します。</p>
          </article>
        </div>
      </section>

      <section class="section" id="work">
        <h2>事例</h2>
        <p>
          ここに制作実績、導入事例、プロフィール、ブランド紹介などを配置できます。
        </p>
      </section>

      <section class="section" id="pricing">
        <h2>料金</h2>
        <p>料金表やプラン比較を配置するエリアです。</p>
      </section>

      <section class="cta" id="contact">
        <h2>まずはお気軽にご相談ください。</h2>
        <a class="button light" href="mailto:hello@example.com">hello@example.com</a>
      </section>
    </main>

    <!-- Footer Template -->
    <footer class="site-footer">
      <p>© 2026 ninjinbusho. All rights reserved.</p>

      <nav class="footer-nav" aria-label="フッターナビゲーション">
        <a href="#">お問い合わせ</a>
      </nav>
    </footer>
  </body>
</html>